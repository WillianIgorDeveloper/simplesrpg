{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"],
      "@interfaces": ["src/interfaces"],
      "@errors": ["src/modules/errors"],
      "@factories": ["src/modules/factories"],
      "@services": ["src/modules/services"],
      "@usecases": ["src/modules/usecases"],
      "@components/*": ["src/presenters/components/*"],
      "@contexts/*": ["src/presenters/contexts/*"],
      "@hooks/*": ["src/presenters/hooks/*"],
      "@layouts/*": ["src/presenters/layouts/*"],
      "@middlewares/*": ["src/presenters/middlewares/*"],
      "@pages/*": ["src/presenters/pages/*"],
      "@utils": ["src/utils"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
